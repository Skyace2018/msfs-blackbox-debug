<Application x:Class="MsfsInputBlackbox.Decoder.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Application.Resources>
    <SolidColorBrush x:Key="AppBackground" Color="#0B1017" />
    <SolidColorBrush x:Key="Surface" Color="#121A24" />
    <SolidColorBrush x:Key="SurfaceRaised" Color="#182332" />
    <SolidColorBrush x:Key="Text" Color="#E7EEF8" />
    <SolidColorBrush x:Key="Muted" Color="#98A8BA" />
    <SolidColorBrush x:Key="Accent" Color="#52A8FF" />
    <Style TargetType="Button">
      <Setter Property="Foreground" Value="{StaticResource Text}" />
      <Setter Property="Background" Value="#1B2A3A" />
      <Setter Property="BorderBrush" Value="#31506F" />
      <Setter Property="Padding" Value="12,7" />
      <Setter Property="Margin" Value="0,0,8,0" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style x:Key="NavButton" TargetType="Button">
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="Foreground" Value="{StaticResource Muted}" />
      <Setter Property="Padding" Value="14,11" />
      <Setter Property="Margin" Value="8,2" />
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Foreground" Value="{StaticResource Text}" />
      <Setter Property="Background" Value="#0F1721" />
      <Setter Property="BorderBrush" Value="#31506F" />
      <Setter Property="Padding" Value="9,7" />
    </Style>
    <Style TargetType="ComboBox">
      <Setter Property="Foreground" Value="{StaticResource Text}" />
      <Setter Property="Background" Value="#0F1721" />
      <Setter Property="BorderBrush" Value="#31506F" />
      <Setter Property="Padding" Value="6" />
    </Style>
  </Application.Resources>
</Application>

