<Window x:Class="MsfsInputBlackbox.Decoder.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MSFS Input Blackbox" Height="900" Width="1440" MinHeight="720" MinWidth="1120"
        Background="{StaticResource AppBackground}" Foreground="{StaticResource Text}"
        WindowStartupLocation="CenterScreen">
  <Window.Resources>
    <Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="{StaticResource Surface}"/><Setter Property="BorderBrush" Value="#263C52"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="14"/><Setter Property="Padding" Value="20"/><Setter Property="Margin" Value="0,0,14,0"/></Style>
  </Window.Resources>
  <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="260"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border Background="#101821" BorderBrush="#24384C" BorderThickness="0,0,1,0">
      <DockPanel>
        <StackPanel DockPanel.Dock="Top" Margin="18,20,18,10">
          <StackPanel Orientation="Horizontal">
            <Border Width="42" Height="42" CornerRadius="12" Background="#1B5E98" Margin="0,0,10,0"><TextBlock Text="✦" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
            <StackPanel><TextBlock Text="BLACKBOX" FontSize="18" FontWeight="Bold"/><TextBlock Text="MSFS input debugger" Foreground="{StaticResource Muted}" FontSize="11"/></StackPanel>
          </StackPanel>
          <Border Margin="0,20,0,2" Padding="10,8" CornerRadius="8" Background="#132536"><TextBlock x:Name="SidebarStatus" Foreground="#8FC9FF" TextWrapping="Wrap"/></Border>
        </StackPanel>
        <StackPanel DockPanel.Dock="Top">
          <Button Style="{StaticResource NavButton}" Tag="Dashboard" Click="Navigate_Click" Content="⌂   Dashboard"/>
          <Button Style="{StaticResource NavButton}" Tag="Live" Click="Navigate_Click" Content="●   Live recording"/>
          <Button Style="{StaticResource NavButton}" Tag="Aircraft" Click="Navigate_Click" Content="✈   Aircraft profiles"/>
          <Button Style="{StaticResource NavButton}" Tag="Tables" Click="Navigate_Click" Content="▤   Telemetry tables"/>
          <Button Style="{StaticResource NavButton}" Tag="Settings" Click="Navigate_Click" Content="⚙   Settings"/>
        </StackPanel>
        <TextBlock DockPanel.Dock="Bottom" Margin="18" Foreground="{StaticResource Muted}" FontSize="11" Text="v0.2 • Local-first diagnostics"/>
      </DockPanel>
    </Border>
    <Grid Grid.Column="1" Margin="30">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <DockPanel Margin="0,0,0,24">
        <StackPanel DockPanel.Dock="Left"><TextBlock x:Name="PageTitle" Text="Dashboard" FontSize="29" FontWeight="SemiBold"/><TextBlock x:Name="PageSubtitle" Foreground="{StaticResource Muted}" Text="Review recent inputs and recorder health."/></StackPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center"><Button Content="Open telemetry dump" Click="OpenDump_Click"/><Button Content="Refresh" Click="Refresh_Click"/></StackPanel>
      </DockPanel>
      <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid>
          <Grid x:Name="DashboardView">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <UniformGrid Rows="1" Columns="3" Margin="0,0,0,18">
              <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="SIMCONNECT" Foreground="{StaticResource Muted}" FontSize="11"/><TextBlock x:Name="ConnectionCard" Text="Recorder not running" FontSize="18" FontWeight="SemiBold" Margin="0,8,0,2"/><TextBlock x:Name="ConnectionDetail" Foreground="{StaticResource Muted}" TextWrapping="Wrap"/></StackPanel></Border>
              <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="LOGGING" Foreground="{StaticResource Muted}" FontSize="11"/><TextBlock x:Name="LoggingCard" Text="Enabled" FontSize="18" FontWeight="SemiBold" Margin="0,8,0,2"/><TextBlock Text="60-second ring buffer" Foreground="{StaticResource Muted}"/></StackPanel></Border>
              <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="ACTIVE PROFILE" Foreground="{StaticResource Muted}" FontSize="11"/><TextBlock x:Name="ProfileCard" Text="Default / all aircraft" FontSize="18" FontWeight="SemiBold" Margin="0,8,0,2"/><TextBlock Text="Per-aircraft rules available" Foreground="{StaticResource Muted}"/></StackPanel></Border>
            </UniformGrid>
            <Border Grid.Row="1" Style="{StaticResource Card}" Height="280"><StackPanel><DockPanel><TextBlock Text="Input timeline" FontSize="17" FontWeight="SemiBold" DockPanel.Dock="Left"/><StackPanel Orientation="Horizontal" DockPanel.Dock="Right"><TextBlock Text="● Yoke" Foreground="#52A8FF" Margin="6,0"/><TextBlock Text="● Rudder" Foreground="#D6A74A" Margin="6,0"/><TextBlock Text="● Throttle" Foreground="#FA746C" Margin="6,0"/></StackPanel></DockPanel><Grid Margin="0,18,0,0"><Line X1="0" X2="1000" Y1="75" Y2="75" Stroke="#26394B"/><TextBlock Text="Open a telemetry dump to plot the final 60 seconds of inputs." Foreground="{StaticResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid></StackPanel></Border>
            <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,18,0,0"><StackPanel><TextBlock Text="Quick actions" FontSize="17" FontWeight="SemiBold"/><WrapPanel Margin="0,16,0,0"><Button Content="Open crash dump" Click="OpenDump_Click"/><Button Content="Configure logging" Tag="Live" Click="Navigate_Click"/><Button Content="Set Community folders" Tag="Settings" Click="Navigate_Click"/></WrapPanel></StackPanel></Border>
          </Grid>
          <Grid x:Name="LiveView" Visibility="Collapsed"><StackPanel><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Live recording" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="These settings are saved locally. Recording begins only when the external SimConnect monitor is connected." Foreground="{StaticResource Muted}" Margin="0,6,0,20"/><CheckBox x:Name="LoggingEnabled" Content="Enable input logging" Checked="LoggingOption_Changed" Unchecked="LoggingOption_Changed"/><CheckBox x:Name="KeepDumps" Content="Write a crash telemetry JSON dump on timeout or disconnect" Checked="LoggingOption_Changed" Unchecked="LoggingOption_Changed" Margin="0,12,0,0"/><StackPanel Orientation="Horizontal" Margin="0,20,0,0"><StackPanel Width="220"><TextBlock Text="History length (seconds)" Foreground="{StaticResource Muted}"/><ComboBox x:Name="HistorySeconds" SelectionChanged="LoggingOption_Changed"><ComboBoxItem Content="30"/><ComboBoxItem Content="60"/><ComboBoxItem Content="120"/></ComboBox></StackPanel><StackPanel Width="220" Margin="18,0,0,0"><TextBlock Text="Sample rate (Hz)" Foreground="{StaticResource Muted}"/><ComboBox x:Name="SampleRate" SelectionChanged="LoggingOption_Changed"><ComboBoxItem Content="15"/><ComboBoxItem Content="30"/><ComboBoxItem Content="60"/></ComboBox></StackPanel></StackPanel></StackPanel></Border></StackPanel></Grid>
          <Grid x:Name="AircraftView" Visibility="Collapsed"><StackPanel><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Aircraft-specific tracking" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="Create a profile for an aircraft title, then tune its logging settings. Profiles are local preferences; they do not change the simulator or aircraft package." Foreground="{StaticResource Muted}" Margin="0,6,0,20"/><TextBlock Text="Profile name" Foreground="{StaticResource Muted}"/><TextBox x:Name="ProfileName" TextChanged="ProfileName_TextChanged"/><TextBlock Text="Aircraft title (exact SimConnect title, optional)" Foreground="{StaticResource Muted}" Margin="0,16,0,0"/><TextBox x:Name="AircraftTitle" Text="Detect from the live monitor when available" IsReadOnly="True"/><TextBlock Text="Detection remains inactive until a supported live SimConnect session provides aircraft identity." Foreground="{StaticResource Muted}" Margin="0,8,0,0"/></StackPanel></Border></StackPanel></Grid>
          <Grid x:Name="TablesView" Visibility="Collapsed"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="210"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="AVAILABLE TABLES" FontSize="12" Foreground="{StaticResource Muted}"/><ListBox x:Name="TablesList" Margin="0,14,0,0" SelectionChanged="TablesList_SelectionChanged"><ListBoxItem Content="Input frames" IsSelected="True"/><ListBoxItem Content="Switch words"/><ListBoxItem Content="Session events"/></ListBox></StackPanel></Border><Border Grid.Column="2" Style="{StaticResource Card}"><StackPanel><TextBlock x:Name="TableTitle" Text="Input frames" FontSize="20" FontWeight="SemiBold"/><TextBlock x:Name="TableHint" Text="Open a dump to populate this table." Foreground="{StaticResource Muted}" Margin="0,4,0,16"/><DataGrid x:Name="TelemetryGrid" AutoGenerateColumns="True" IsReadOnly="True" CanUserAddRows="False" Background="#0F1721" Foreground="{StaticResource Text}" BorderBrush="#31506F"/></StackPanel></Border></Grid></Grid>
          <Grid x:Name="SettingsView" Visibility="Collapsed"><StackPanel><Border Style="{StaticResource Card}"><StackPanel><DockPanel><StackPanel DockPanel.Dock="Left"><TextBlock Text="Simulator locations" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="Detected candidates are read-only. Choose a path to save it as this tool’s local preference." Foreground="{StaticResource Muted}"/></StackPanel><Button DockPanel.Dock="Right" Content="Find local folders" Click="FindFolders_Click"/></DockPanel><TextBlock Text="MSFS 2024 Community folder" Foreground="{StaticResource Muted}" Margin="0,22,0,5"/><DockPanel><Button DockPanel.Dock="Right" Content="Browse" Click="Browse2024_Click"/><Button DockPanel.Dock="Right" Content="Open" Click="Open2024_Click"/><TextBox x:Name="Msfs2024Path" TextChanged="Path_TextChanged"/></DockPanel><TextBlock Text="MSFS 2020 Community folder" Foreground="{StaticResource Muted}" Margin="0,18,0,5"/><DockPanel><Button DockPanel.Dock="Right" Content="Browse" Click="Browse2020_Click"/><Button DockPanel.Dock="Right" Content="Open" Click="Open2020_Click"/><TextBox x:Name="Msfs2020Path" TextChanged="Path_TextChanged"/></DockPanel></StackPanel></Border><Border Style="{StaticResource Card}" Margin="0,18,0,0"><StackPanel><TextBlock Text="Detected candidates" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="Double-click a candidate to use it. ✓ means the folder exists." Foreground="{StaticResource Muted}" Margin="0,4,0,12"/><ListBox x:Name="CandidatesList" Height="190" MouseDoubleClick="CandidatesList_DoubleClick"/></StackPanel></Border></StackPanel></Grid>
        </Grid>
      </ScrollViewer>
    </Grid>
  </Grid>
</Window>

