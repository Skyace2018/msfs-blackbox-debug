<Window x:Class="MsfsInputBlackbox.Decoder.TrayFlyout"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Blackbox live dashboard" Width="390" Height="430" ShowInTaskbar="False"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True"
        Background="Transparent" Topmost="True" ShowActivated="True">
  <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}"
          BorderThickness="1" CornerRadius="14" Padding="18">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel>
      <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
        <Border Width="34" Height="34" CornerRadius="9" Background="#1B5E98" Margin="0,0,10,0">
          <TextBlock Text="✦" Foreground="White" FontSize="19" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <StackPanel VerticalAlignment="Center"><TextBlock Text="BLACKBOX" FontWeight="Bold" Foreground="{DynamicResource Text}"/>
          <TextBlock Text="Live session dashboard" Foreground="{DynamicResource Muted}" FontSize="11"/></StackPanel>
      </StackPanel>
      <Border Background="{DynamicResource SurfaceRaised}" CornerRadius="8" Padding="10" Margin="0,0,0,10">
        <StackPanel>
          <TextBlock x:Name="StatusText" Foreground="{DynamicResource Text}" FontWeight="SemiBold" TextWrapping="Wrap"/>
          <TextBlock x:Name="SessionText" Foreground="{DynamicResource Muted}" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap"/>
        </StackPanel>
      </Border>
      <TextBlock x:Name="AircraftText" Foreground="{DynamicResource Text}" TextWrapping="Wrap" Margin="0,0,0,7"/>
      <TextBlock x:Name="InputText" Foreground="{DynamicResource Text}" TextWrapping="Wrap" Margin="0,0,0,7"/>
      <TextBlock x:Name="BufferText" Foreground="{DynamicResource Muted}" Margin="0,0,0,8"/>
      <TextBlock x:Name="CaptureText" Foreground="{DynamicResource Accent}" TextWrapping="Wrap" MinHeight="30" Margin="0,0,0,8"/>
      <Button x:Name="MarkButton" Content="Mark event + export" Click="MarkEvent_Click"
              ToolTip="Timestamp this live session and automatically save a developer ZIP with buffered inputs"
              Margin="0,0,0,8"/>
      <Button Content="Open full screen" Click="Restore_Click" ToolTip="Show the main Blackbox dashboard maximized" Margin="0,0,0,6"/>
      <Button Content="Minimize to tray" Click="Minimize_Click" ToolTip="Close this quick panel while Blackbox stays in the tray" Margin="0,0,0,6"/>
      <Button Content="Exit Blackbox" Click="Exit_Click" ToolTip="Stop the desktop viewer and remove its tray icon" Margin="0"/>
    </StackPanel>
    </ScrollViewer>
  </Border>
</Window>
