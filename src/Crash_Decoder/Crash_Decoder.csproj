<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationIcon>$(MSBuildProjectDirectory)\obj\Blackbox.ico</ApplicationIcon>
  </PropertyGroup>
  <Target Name="GenerateBlackboxIcon" BeforeTargets="CoreCompile">
    <Exec Command="powershell -NoProfile -File &quot;$(MSBuildProjectDirectory)\Assets\GenerateBlackboxIcon.ps1&quot; &quot;$(MSBuildProjectDirectory)\obj\Blackbox.ico&quot;" />
  </Target>
  <ItemGroup>
    <!-- Retained temporarily for source-history reference; the WPF shell replaces these WinForms views. -->
    <Compile Remove="DecoderForm.cs" />
    <Compile Remove="TimelinePanel.cs" />
    <Compile Remove="Program.cs" />
  </ItemGroup>
</Project>
