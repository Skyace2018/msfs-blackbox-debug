<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework Condition="'$(EnableSimConnect)' != 'true'">net8.0</TargetFramework>
    <TargetFramework Condition="'$(EnableSimConnect)' == 'true'">net8.0-windows</TargetFramework>
    <UseWindowsForms Condition="'$(EnableSimConnect)' == 'true'">true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <EnableSimConnect Condition="'$(EnableSimConnect)' == ''">false</EnableSimConnect>
  </PropertyGroup>
  <PropertyGroup Condition="'$(EnableSimConnect)' == 'true'">
    <DefineConstants>$(DefineConstants);MSFS_SIMCONNECT</DefineConstants>
  </PropertyGroup>
  <ItemGroup Condition="'$(EnableSimConnect)' == 'true' and '$(SimConnectInteropPath)' != ''">
    <Reference Include="Microsoft.FlightSimulator.SimConnect">
      <HintPath>$(SimConnectInteropPath)</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>
  <ItemGroup>
    <Compile Remove="artifacts/**/*.cs" />
  </ItemGroup>
  <Target Name="RequireSimConnectPath" BeforeTargets="ResolveReferences" Condition="'$(EnableSimConnect)' == 'true' and !Exists('$(SimConnectInteropPath)')">
    <Error Text="EnableSimConnect=true requires -p:SimConnectInteropPath=&lt;path to Microsoft.FlightSimulator.SimConnect.dll&gt;. The SDK DLL is not distributed by this repository." />
  </Target>
</Project>
